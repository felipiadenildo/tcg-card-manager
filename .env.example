# Copy this file to .env and adjust the values if you want, the defaults
# work fine for local development. .env is listed in .gitignore, so real
# values never end up committed.

DB_NAME=tcg_gbc
DB_USER=tcg_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# Name of the session cookie. Only needs changing when more than one copy of
# the app runs on the same host, since browsers share cookies across ports.
SESSION_NAME=tcg_session
